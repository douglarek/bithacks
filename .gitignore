# ===== Build outputs =====
# CMake build directories
build/
cmake-build-*/
out/

# Compiled object files
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib

# Executables
*.out
*.exe
# (course executables have no extension on Linux; they live in build/, already ignored)

# ===== CMake =====
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
compile_commands.json
*.cmake.user

# ===== Debug / runtime artifacts =====
# Core dumps (from SIGSEGV etc. during memory lessons)
core
core.*
*.stackdump

# Valgrind output
*.vglog
cachegrind.out.*

# ===== Editors / IDEs =====
.vscode/
.idea/
*.swp
*.swo
*~
.cache/
.clwb

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Local environment / secrets =====
.env
.env.local
*.local
